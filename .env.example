# 应用与本地存储配置。
# 复制本文件为 .env 后再填写实际值，不要把包含密钥的 .env 提交到 Git。
APP_NAME=Mini RAG Handwrite
APP_ENV=development

# 以该路径的父目录和扩展名按本地日期分层写入日志；相对路径以项目根目录为基准。
# 例如 ./logs/app.log 会写入 ./logs/YYYY/MM/YYYY-MM-DD.log。
LOG_FILE=./logs/app.log
# 当天日志文件达到 10 MB 后在当天目录内轮转为 YYYY-MM-DD.log.1、.2 等文件。
LOG_MAX_BYTES=10485760
# 每个日期文件最多保留 5 个按大小轮转的备份；不同日期的文件不会由此参数自动清理。
LOG_BACKUP_COUNT=5

# 本地默认连接 Compose 中的 PostgreSQL；生产环境必须替换账号和密码。
DATABASE_URL=postgresql+psycopg://mini_rag:mini_rag@localhost:5432/mini_rag
# Compose 创建数据库时使用；不要在生产环境沿用示例密码。
POSTGRES_DB=mini_rag
POSTGRES_USER=mini_rag
POSTGRES_PASSWORD=mini_rag

# Agent 执行状态与业务表分开保存，供同一 thread 跨请求恢复。
AGENT_CHECKPOINT_FILE=./data/agent_checkpoints.db
# 上传原文件的目录；相对路径以项目根目录为基准。
FILE_STORAGE_DIR=./data/files
# 单个上传原文件上限，默认 20 MiB（20 × 1024 × 1024 字节）。
MAX_UPLOAD_FILE_BYTES=20971520

# Compose 中 API 通过 chroma:8000 访问；本机直接运行 Python 时使用回环映射 127.0.0.1:8001。
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
# 命名空间由 scripts/provision_chroma_namespace.py 显式创建；应用只连接，不在启动时创建。
CHROMA_TENANT=mini_rag_tenant
CHROMA_DATABASE=mini_rag_chroma
# 正式档案 Chunk 使用独立 Collection；历史 Collection 不再由当前应用配置。
CHROMA_FINAL_COLLECTION=archive_final_chunks

# 模型路径可以是绝对路径，也可以是相对于项目根目录的路径。
EMBEDDING_MODEL_PATH=../../../models/embedding_models/bge-base-zh-v1.5
# Docker Compose 挂载使用的宿主机目录；其他电脑可改为自己的模型路径。
EMBEDDING_MODEL_HOST_PATH=../../../models/embedding_models/bge-base-zh-v1.5
# 16 GB 内存电脑默认使用 CPU，避免与其他服务争用显存。
EMBEDDING_DEVICE=cpu
# 维度必须与实际 Embedding 模型输出一致，bge-base-zh-v1.5 为 768。
EMBEDDING_DIMENSION=768

# 这里只保留占位符；真实 DeepSeek 密钥应写入本地 .env。
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 单次 DeepSeek 请求固定超时秒数；必须大于 0。
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=30

# 账号密码认证。请用安全随机值替换占位符；为空时认证接口会返回 AUTH_NOT_CONFIGURED。
# PowerShell 示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=7

ARCHIVE_EMBEDDING_CONTEXT_MODE=evidence_values
# 本机模型位于仓库外的统一模型目录；其他环境按实际目录覆盖。
ARCHIVE_RERANKER_MODEL_PATH=../../../models/embedding_models/bge-reranker-base
# Reranker 查询实验模式；C4-A 为默认基线，C4-B 仅用于经授权的查询表达复验。
ARCHIVE_RERANKER_QUERY_MODE=c4_a
